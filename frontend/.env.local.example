# ============================================================
# HelioPulse Frontend — Next.js Environment Variables Template
# Copy to .env.local (never commit .env.local to git).
# ============================================================

# Backend FastAPI base URL — used by lib/api.ts
# Default points to local dev server
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: override the /api/backend rewrite target
# NEXT_PUBLIC_API_URL=https://api.heliopulse.yourdomain.com

