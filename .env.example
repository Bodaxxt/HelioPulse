# ============================================================
# HelioPulse Backend — Environment Variables Template
# Copy to .env and fill in your values.
# ============================================================

# API Behaviour
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warning | error

# CORS — comma-separated origins allowed to call the backend
# In production restrict to your frontend domain
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Open-Meteo (no key required — public API)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Snapshot / cache directory (relative to project root)
SNAPSHOT_DIR=snapshots

# Default financial constants (EGP)
DEFAULT_ELECTRICITY_RATE_EGP=2.0
DEFAULT_CLEANING_COST_EGP=5000.0

# Automated WhatsApp Operations Dispatch (Twilio)
# Leave blank to operate in local resilient simulation mode (zero cost & 100% testable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEFAULT_DISPATCH_PHONE=+201012345678


